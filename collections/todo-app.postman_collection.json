{
  "info": {
    "_postman_id": "66ff1d6e-5dd8-4593-8b99-ac7ff6293e7f",
    "name": "Todo App API",
    "description": "Complete collection for the Todo App API built with FastAPI. Includes CRUD operations for todos with Basic Auth.\n\n**Getting started:**\n1. Import the `local.postman_environment.json` environment\n2. Select the `Todo App - Local` environment\n3. Run `Create Todo` — the ID is automatically saved to a variable\n4. Other requests will use the ID automatically",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "54930360"
  },
  "item": [
    {
      "name": "Todos",
      "item": [
        {
          "name": "Get All Todos",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Saves the cursor for Get Next Page, if the response provides one.",
                  "const body = pm.response.json();",
                  "const cursor = body.next_cursor || body.next || null;",
                  "if (cursor) {",
                  "    pm.collectionVariables.set('next_cursor', cursor);",
                  "} else {",
                  "    pm.collectionVariables.unset('next_cursor');",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{protocol}}{{host}}{{port}}/todos",
              "host": [
                "{{protocol}}{{host}}{{port}}"
              ],
              "path": [
                "todos"
              ],
              "query": [
                {
                  "key": "order",
                  "value": "desc",
                  "disabled": true
                }
              ]
            },
            "description": "Returns a list of all todos. If the API returns a pagination cursor, it is automatically saved to `next_cursor`."
          },
          "response": []
        },
        {
          "name": "Get Next Page",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "if (!pm.collectionVariables.get('next_cursor')) {",
                  "    pm.execution.skipRequest();",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Saves the cursor for the following page, if the response provides one.",
                  "const body = pm.response.json();",
                  "const cursor = body.next_cursor || body.next || null;",
                  "if (cursor) {",
                  "    pm.collectionVariables.set('next_cursor', cursor);",
                  "} else {",
                  "    pm.collectionVariables.unset('next_cursor');",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{protocol}}{{host}}{{port}}/todos",
              "host": [
                "{{protocol}}{{host}}{{port}}"
              ],
              "path": [
                "todos"
              ],
              "query": [
                {
                  "key": "cursor",
                  "value": "{{next_cursor}}",
                  "disabled": true
                }
              ]
            },
            "description": "Loads the next page of results using the cursor from the previous call.\n\n> Pagination template — the current API does not support pagination. Run after `Get All Todos` when `next_cursor` is not empty."
          },
          "response": []
        },
        {
          "name": "Create Todo",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// due_date = today + 7 days (YYYY-MM-DD), reused by Create Todo and Update Todo bodies.",
                  "// moment is built into the Postman sandbox (dayjs is not, and pm.require doesn't work in newman).",
                  "const moment = require('moment');",
                  "pm.collectionVariables.set('due_date', moment().add(7, 'days').format('YYYY-MM-DD'));"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Saves the new todo's ID — Get Todo by ID, Update Todo and Delete Todo read it via {{todo_id}} in their URL.",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('todo_id', body.id);"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"{{$randomLoremWords}}\",\n  \"description\": \"Created via Postman collection\",\n  \"completed\": false,\n  \"due_date\": \"{{due_date}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{protocol}}{{host}}{{port}}/todos",
              "host": [
                "{{protocol}}{{host}}{{port}}"
              ],
              "path": [
                "todos"
              ]
            },
            "description": "Creates a new todo. The ID is automatically saved to the `todo_id` collection variable, which is then used by Get, Update and Delete."
          },
          "response": []
        },
        {
          "name": "Get Todo by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{protocol}}{{host}}{{port}}/todos/{{todo_id}}",
              "host": [
                "{{protocol}}{{host}}{{port}}"
              ],
              "path": [
                "todos",
                "{{todo_id}}"
              ]
            },
            "description": "Returns the detail of a specific todo. Uses `todo_id` saved after Create Todo."
          },
          "response": []
        },
        {
          "name": "Update Todo",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"completed\": true,\n  \"description\": \"Updated via Postman\",\n  \"due_date\": \"{{due_date}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{protocol}}{{host}}{{port}}/todos/{{todo_id}}",
              "host": [
                "{{protocol}}{{host}}{{port}}"
              ],
              "path": [
                "todos",
                "{{todo_id}}"
              ]
            },
            "description": "Updates an existing todo. Fields are optional — only send the ones you want to change."
          },
          "response": []
        },
        {
          "name": "Delete Todo",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{protocol}}{{host}}{{port}}/todos/{{todo_id}}",
              "host": [
                "{{protocol}}{{host}}{{port}}"
              ],
              "path": [
                "todos",
                "{{todo_id}}"
              ]
            },
            "description": "Deletes a todo by ID. Returns 204 with no response body."
          },
          "response": []
        },
        {
          "id": "76ba9dc5-deae-4b70-b3ac-2f1693247e67",
          "name": "Get overdue TODOs",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{protocol}}{{host}}{{port}}/todos/overdue",
              "host": [
                "{{protocol}}{{host}}{{port}}"
              ],
              "path": [
                "todos",
                "overdue"
              ]
            },
            "description": {}
          },
          "response": []
        }
      ],
      "description": "CRUD operations for managing todos"
    },
    {
      "name": "Errors",
      "item": [
        {
          "name": "Get Non-Existent Todo (404)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{protocol}}{{host}}{{port}}/todos/999999",
              "host": [
                "{{protocol}}{{host}}{{port}}"
              ],
              "path": [
                "todos",
                "999999"
              ]
            },
            "description": "Verifies that the API returns 404 for a non-existent ID."
          },
          "response": []
        },
        {
          "name": "Create Todo Without Title (422)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"description\": \"Missing required title\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{protocol}}{{host}}{{port}}/todos",
              "host": [
                "{{protocol}}{{host}}{{port}}"
              ],
              "path": [
                "todos"
              ]
            },
            "description": "Verifies validation — title is a required field."
          },
          "response": []
        },
        {
          "name": "Unauthorized Request (401)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{protocol}}{{host}}{{port}}/todos",
              "host": [
                "{{protocol}}{{host}}{{port}}"
              ],
              "path": [
                "todos"
              ]
            },
            "description": "Verifies that the API rejects a request without authentication."
          },
          "response": []
        }
      ],
      "description": "Tests for error states and edge cases"
    }
  ],
  "auth": {
    "type": "basic",
    "basic": [
      {
        "key": "username",
        "value": "{{username}}",
        "type": "string"
      },
      {
        "key": "password",
        "value": "{{password}}",
        "type": "string"
      }
    ]
  }
}
